FROM python:3.12-slim-bookworm AS build
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project --extra s2s-agent
COPY src/ ./src/
RUN uv sync --frozen --no-dev --extra s2s-agent

FROM python:3.12-slim-bookworm AS final
LABEL org.opencontainers.image.source="https://github.com/coval-ai/benchmarks" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="coval-bench-s2s-agent"
RUN groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --home-dir /app --shell /sbin/nologin nonroot
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"
COPY --from=build --chown=65532:65532 /app /app
USER 65532:65532
EXPOSE 8080
CMD ["python", "-m", "coval_bench.s2s_agent.app"]
