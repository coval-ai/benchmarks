# Local dev environment — copy to .env and fill in provider keys as needed.
# Real .env files are gitignored.

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=benchmarks

# DATABASE_URL is set automatically inside docker-compose for the api/runner/migrate
# services. If you run `coval-bench` directly on the host, point it at the compose db:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/benchmarks

# --- Runner / dataset ---
DATASET_BUCKET=coval-benchmarks-datasets
BENCHMARK_ARTIFACT_BUCKET=
NORMALIZED_DUAL_WRITE_ENABLED=false
# Unset runs stt-v3 at 10 items (dedicated source walks runner/src/coval_bench/datasets/suite.py).
# DATASET_ID=stt-v3
# DATASET_SAMPLE_SIZE=10
LOG_LEVEL=INFO

# --- Provider API keys (optional; only needed for the providers you want to exercise) ---
RESON8_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
SPEECHMATICS_API_KEY=
HUME_API_KEY=
RIME_API_KEY=
GLADIA_API_KEY=
GRADIUM_API_KEY=
GRADIUM_TTS_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
SMALLEST_API_KEY=
SONIOX_API_KEY=
REVAI_API_KEY=
FISHAUDIO_API_KEY=
ALIBABA_API_KEY=
TOGETHER_API_KEY=
MINIMAX_API_KEY=
MODULATE_API_KEY=
LMNT_API_KEY=
FLUXIONS_API_KEY=
DEEPDUB_API_KEY=
MURFAI_API_KEY=
HAKIMAI_API_KEY=
ZOOM_API_KEY=
ZOOM_API_SECRET=
PHONELY_API_KEY=
AIRY_API_KEY=

# --- Phonely LLM proxy (optional) ---
PHONELY_BASE_URL=https://db.phonely.ai
PHONELY_AGENT_ID=
LLM_PROXY_SECRET=

# --- API (optional) ---
# Auth: see runner/README.md "API auth". Clerk gates early access and is one of
# two admin proofs; the other is a Google identity token for a listed email.
# CLERK_ISSUER=https://clerk.example.com
# CLERK_AUTHORIZED_PARTIES=["https://benchmarks.coval.ai"]
# CLERK_COVAL_ORG=org_the_coval_staff_org
# ADMIN_GOOGLE_EMAILS=["admin@example.com"]

# --- Google STT/TTS (optional; requires the `google-stt` / `google-tts` extras) ---
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_PROJECT_ID=

# --- Azure AI Speech STT + TTS (subscription key + region of the Speech resource) ---
# AZURE_API_KEY=
# AZURE_REGION=eastus
ATLAS_API_KEY=
NARI_API_KEY=
