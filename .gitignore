.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db
.vercel
node_modules

# Local knowledge base (never commit)
insights.md

# Local scripts dir (one-off scripts, generated audio, etc.)
scripts.local/

# Local-only markdown (never commit — use a .local.md suffix)
**/*.local.md

# Internal provider docs / planning notes — never commit
docs/providers/

# Package manager / toolchain caches (local)
.pnpm-store/
.uv-cache/
runner/.uv-cache/

# Playground internal docs (per Loren's PR #26 R4-1 review)
PLAYGROUND.md
.env*.local

# Internal benchmarking doc — never commit (also matches global *-benchmarking.md)
docs/providers/cartesia-sonic-3.5-benchmarking.md

# The evaluator never leaves the machine. Scenario scripts, assertions, and the
# mock fixtures derived from them would let a platform optimise for the test
# rather than the task. The tool schemas stay public: those are the interface
# both the agent and the mock service bind to, and a reader needs them to audit
# a result. The answers do not.
runner/src/coval_bench/contracts/*/_private/

# Local scratch audio from arena runs. Large, regenerable, and easy to sweep
# into a commit by accident.
runner/arena-audio/
